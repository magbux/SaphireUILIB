-- // SAPHIRE HUB SCRIPT BELOW //

local Window = SaphireLib:CreateWindow({
    Name = "Saphire Hub"
})

-- TAB: MAIN
local MainTab = Window:CreateTab("Main")

MainTab:CreateButton("WalkSpeed 50", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 50
    end
end)

MainTab:CreateButton("Reset Speed", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 16
    end
end)

MainTab:CreateToggle("Super Jump", false, function(State)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        if State then
            LocalPlayer.Character.Humanoid.JumpPower = 100
            LocalPlayer.Character.Humanoid.UseJumpPower = true
        else
            LocalPlayer.Character.Humanoid.JumpPower = 50
        end
    end
end)

MainTab:CreateSlider("FOV Slider", 70, 120, 70, function(Value)
    game:GetService("Workspace").CurrentCamera.FieldOfView = Value
end)

-- TAB: VISUALS
local VisualsTab = Window:CreateTab("Visuals")

VisualsTab:CreateButton("FullBright", function()
    game:GetService("Lighting").Brightness = 2
    game:GetService("Lighting").ClockTime = 14
    game:GetService("Lighting").FogEnd = 100000
    game:GetService("Lighting").GlobalShadows = false
    game:GetService("Lighting").OutdoorAmbient = Color3.fromRGB(128, 128, 128)
end)

VisualsTab:CreateToggle("Highlight Player (ESP)", false, function(State)
    if State then
        local Highlight = Instance.new("Highlight")
        Highlight.Name = "SaphireESP"
        Highlight.FillColor = Color3.fromRGB(80, 140, 255)
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.Parent = LocalPlayer.Character
    else
        if LocalPlayer.Character:FindFirstChild("SaphireESP") then
            LocalPlayer.Character.SaphireESP:Destroy()
        end
    end
end)

-- TAB: MISC
local MiscTab = Window:CreateTab("Misc")

MiscTab:CreateButton("Rejoin Server", function()
    game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
end)

MiscTab:CreateButton("Destroy UI", function()
    if game:GetService("CoreGui"):FindFirstChild("SaphireUI") then
        game:GetService("CoreGui").SaphireUI:Destroy()
    elseif LocalPlayer.PlayerGui:FindFirstChild("SaphireUI") then
        LocalPlayer.PlayerGui.SaphireUI:Destroy()
    end
end)
